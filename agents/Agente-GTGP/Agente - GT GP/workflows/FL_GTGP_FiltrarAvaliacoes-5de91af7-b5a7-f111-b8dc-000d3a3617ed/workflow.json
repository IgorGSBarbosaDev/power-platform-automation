        "Matriz_do_filtro": {
          "type": "Query",
          "inputs": {
            "from": "@outputs(\u0027Listar_linhas_presentes_em_uma_tabela\u0027)?[\u0027body/value\u0027]",
            "where": "@and(\r\n    if(\r\n        equals(\r\n            toLower(trim(variables(\u0027ModoFiltro\u0027))),\r\n            \u0027ultima\u0027\r\n        ),\r\n        equals(\r\n            toUpper(string(item()?[\u0027UltimoPotencial\u0027])),\r\n            toUpper(trim(variables(\u0027PotencialFiltro\u0027)))\r\n        ),\r\n        true\r\n    ),\r\n    if(\r\n        empty(variables(\u0027ColunaGrupo\u0027)),\r\n        true,\r\n        contains(\r\n            toLower(string(item()?[variables(\u0027ColunaGrupo\u0027)])),\r\n            toLower(trim(variables(\u0027ValorGrupo\u0027)))\r\n        )\r\n    )\r\n)"
