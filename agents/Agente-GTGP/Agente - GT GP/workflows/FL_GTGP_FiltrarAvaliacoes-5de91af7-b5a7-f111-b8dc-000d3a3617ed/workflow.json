        "FiltroAvaliacao": {
          "type": "Compose",
          "inputs": "@if(\r\n    equals(\r\n        toLower(trim(variables(\u0027ModoFiltro\u0027))),\r\n        \u0027ultima\u0027\r\n    ),\r\n    concat(\r\n        \u0027UltimaNota eq \u0027\u0027\u0027,\r\n        replace(\r\n            trim(variables(\u0027NotaFiltro\u0027)),\r\n            \u0027\u0027\u0027\u0027,\r\n            \u0027\u0027\u0027\u0027\u0027\u0027\r\n        ),\r\n        \u0027\u0027\u0027\u0027\r\n    ),\r\n    concat(\r\n        \u0027contains(HistoricoAvaliacoes,\u0027\u0027Nota: \u0027,\r\n        replace(\r\n            trim(variables(\u0027NotaFiltro\u0027)),\r\n            \u0027\u0027\u0027\u0027,\r\n            \u0027\u0027\u0027\u0027\u0027\u0027\r\n        ),\r\n        \u0027 | Potencial: \u0027,\r\n        replace(\r\n            toUpper(trim(variables(\u0027PotencialFiltro\u0027))),\r\n            \u0027\u0027\u0027\u0027,\r\n            \u0027\u0027\u0027\u0027\u0027\u0027\r\n        ),\r\n        \u0027\u0027\u0027)\u0027\r\n    )\r\n)",
          "runAfter": {
            "Op\u00E7\u00E3o": [
              "SUCCEEDED"
            ]
          }
        },
